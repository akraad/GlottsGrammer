  "common_errors": [
    {
      "id": "err_trloc_1",
      "incorrect": "Ali şu an evda.",
      "explanation": "Use '-de' for front vowels (e, i, ö, ü) and '-da' for back vowels (a, ı, o, u). Change 'd' to 't' after unvoiced consonants."
