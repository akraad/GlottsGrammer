  "prerequisites": [
    "en.a1.pronoun.personal-subject"
  ],
  "forms": [
    {
      "id": "base_with_i_you_we_they",
      "type": "affirmative_base",
      "pattern": [
        "subject_I_you_we_they",
        "verb_base"
      ],
      "example": "I drink water."
    },
    {
      "id": "base_after_does_not",
      "type": "negative_with_does",
      "pattern": [
        "subject_he_she_it",
        "does",
        "not",
        "verb_base"
      ],
      "example": "She does not drink coffee."
    },
    {
      "id": "base_after_do_question",
      "type": "question_with_do",
      "pattern": [
        "Do_or_Does",
        "subject",
        "verb_base"
      ],
      "example": "Do you drink tea?"
    }
  ],
  "examples": [
    {
      "id": "ex_01",
      "target_text": "I drink water.",
      "reading": null,
      "transliteration": null,
      "audio": "audio/en/a1/verb/base-form/ex_01.mp3"
    },
    {
      "id": "ex_02",
      "target_text": "They do not drink tea.",
